# Copy to .env.local for local dev

# Backend selection: "json" (default zero-config store) or "firebase" (Cloud Firestore)
DATA_BACKEND="json"

# PostgreSQL (optional — see prisma/schema.prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/solar_mgmt"

# Firebase (Cloud Firestore backend — see lib/firebase.ts)
# When NEXT_PUBLIC_FIREBASE_PROJECT_ID is provided, Firestore will be used automatically.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Deploy URL (used by SSR and React Native starter to hit REST APIs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
EXPO_PUBLIC_API_URL="http://localhost:3000"
